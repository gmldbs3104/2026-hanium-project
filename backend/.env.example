# backend/.env.example
# 이 파일을 복사해서 .env로 만들고 값을 채우세요
# cp .env.example .env

APP_NAME="AI Handwriting Correction API"
DEBUG=True

DATABASE_URL=postgresql+asyncpg://username:password@localhost:5432/handwriting_db

FIREBASE_CREDENTIALS_PATH=./firebase-credentials.json

SECRET_KEY=your-secret-key-here
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_BUCKET_NAME=
AWS_REGION=ap-northeast-2

REDIS_URL=redis://localhost:6379

# 캔버스 모드 종합 점수 가중치 (REQ-005C-6)
# TODO: 아래 값은 임시 초기값입니다. 실제 손글씨 데이터 테스트 후 팀 협의로 확정 필요
CANVAS_STROKE_ORDER_PENALTY=10.0  # 획순 오류 1건당 감점
CANVAS_SPACING_PENALTY_COEFF=0.5  # 자간 편차 감점 계수
CANVAS_SPACING_PENALTY_MAX=30.0   # 자간 최대 감점 상한
CANVAS_SIZE_PENALTY_COEFF=0.5     # 크기 편차 감점 계수
CANVAS_SIZE_PENALTY_MAX=30.0      # 크기 최대 감점 상한

# 이미지 모드 종합 점수 가중치 (REQ-005I-5) — 합계 = 1.0
# TODO: 아래 값은 임시 초기값입니다. 실제 손글씨 데이터 테스트 후 팀 협의로 확정 필요
IMAGE_SIZE_WEIGHT=0.4    # 크기 균일성 가중치
IMAGE_SLANT_WEIGHT=0.35  # 기울기 일관성 가중치
IMAGE_LINE_WEIGHT=0.25   # 줄 정렬 가중치