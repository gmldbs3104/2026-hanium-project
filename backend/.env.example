# backend/.env.example
# 이 파일을 복사해서 .env로 만들고 값을 채우세요
# cp .env.example .env

APP_NAME="AI Handwriting Correction API"
DEBUG=True

DATABASE_URL=postgresql+asyncpg://username:password@localhost:5432/handwriting_db

FIREBASE_CREDENTIALS_PATH=./firebase-credentials.json

# 카카오 로그인 (선택) — 설정하면 access_token이 우리 앱에서 발급된 것인지 검증한다.
# 카카오 developers > 내 애플리케이션 > 앱 설정 > 요약 정보의 '앱 ID'(숫자).
# 미설정 시 검증을 건너뛴다(개발 편의). 운영에서는 설정 권장.
# (값이 없으면 아래 줄을 주석 처리한 채로 두세요 — 빈 값은 정수 파싱에서 터집니다.)
# KAKAO_APP_ID=123456

SECRET_KEY=your-secret-key-here
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# AWS S3 이미지 업로드 (SFR-009)
# 미설정 시 S3 업로드를 건너뜁니다 — 이미지 파이프라인 나머지 기능은 정상 동작
# 버킷 정책: 프라이빗 권장. 퍼블릭 URL 직접 접근이 필요하면 버킷/객체 퍼블릭 설정 필요.
#   Key 경로: handwriting/{session_id}/original.{jpg|png|webp}
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_BUCKET_NAME=
AWS_REGION=ap-northeast-2

REDIS_URL=redis://localhost:6379

# 채점 계수·가중치는 여기 없다 — 채점은 AI가 소유한다(DATA_FLOW.md §5-11·§8-G).
#   · 캔버스 → ai/canvas/canvas_quality_analyzer.py의 canvas_item_scores()
#   · 이미지 → ai/analysis/handwriting_analyzer.py의 WEIGHTS (3:3:3:2:2)
# 2026-08-12에 CANVAS_*(5) + IMAGE_*_WEIGHT(3)를 지웠다. Settings가 extra="forbid"라
# 이 키들을 .env에 남겨두면 앱이 기동에서 터진다.
