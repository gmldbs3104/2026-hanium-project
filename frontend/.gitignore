# Flutter/Dart 표준 .gitignore

.dart_tool/
.flutter-plugins
.flutter-plugins-dependencies
.packages
.pub-cache/
.pub/
build/
*.lock

# 네이티브 프로젝트 (flutter create . 실행 시 생성됨)
android/
ios/
linux/
macos/
windows/
# web/은 커밋함 — index.html에 google-signin-client_id 메타 태그가 있어서
# 팀원마다 flutter create .로 새로 생성하면 이 태그가 빠져 로그인이 깨짐

# IDE
.idea/
*.iml
.vscode/

# OS
.DS_Store
Thumbs.db
